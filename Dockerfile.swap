# Character-swap worker (endpoint character-swap): the studio's H3 worker image (worker-comfyui
# 5.10.0-base + torch 2.11.0+cu130 + ComfyUI v0.43.1 + h3_handler) plus akatz-ai/h3-relay
# (windowed Ref2VA edit, mask / history nodes) at a pinned commit. SAM3 nodes are built into
# ComfyUI v0.43.1. Weights come from Runpod's cached-model feature (Hugging Face repo
# GloriaWang23/character-swap-runtime; set H3_MODEL_REPO / H3_MODEL_SHA on the template),
# linked to /h3-models at start.
ARG BASE_IMAGE=ghcr.io/gloriawang23/h3-comfy-worker:sha-0454363
FROM ${BASE_IMAGE}

ARG H3_RELAY_COMMIT=e2a7665b6eb8ea37a88c0de2c9c6b69a8f7c9220

# 1. H3 Relay at a pinned commit (no Python dependencies of its own).
RUN git clone https://github.com/akatz-ai/h3-relay.git /comfyui/custom_nodes/h3-relay \
    && cd /comfyui/custom_nodes/h3-relay \
    && git checkout ${H3_RELAY_COMMIT} \
    && rm -rf .git examples docs tests

# 2. SAM3.1 loads through CheckpointLoaderSimple: map checkpoints/ in the cached snapshot too.
RUN printf '  checkpoints: checkpoints/\n' >> /comfyui/extra_model_paths.yaml \
    && tail -n 7 /comfyui/extra_model_paths.yaml

# 2b. character-swap helper nodes (SAM3 with cuDNN off, see the package docstring).
COPY comfy_nodes/cswap_nodes /comfyui/custom_nodes/cswap_nodes

# 3. Face identity for template preprocessing (swap_faces.py): insightface (SCRFD + ArcFace +
#    genderage, the buffalo_l pack) on onnxruntime CPU -- about 80 frames per template, no GPU
#    contention with ComfyUI, no CUDA-version coupling. Both install as wheels. The model pack is
#    baked in (downloaded with Python: the image has no curl / unzip).
ARG INSIGHTFACE_VERSION=2.1
ARG ONNXRUNTIME_VERSION=1.31.1
RUN uv pip install "insightface==${INSIGHTFACE_VERSION}" "onnxruntime==${ONNXRUNTIME_VERSION}" \
    && rm -rf /root/.cache \
    && python -c "import io, os, urllib.request, zipfile; d = '/opt/insightface/models/buffalo_l'; os.makedirs(d); z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen('https://github.com/deepinsight/insightface/releases/download/v0.7/buffalo_l.zip', timeout=300).read())); [open(os.path.join(d, os.path.basename(n)), 'wb').write(z.read(n)) for n in z.namelist() if n.endswith('.onnx')]; print(sorted(os.listdir(d)))" \
    && test -f /opt/insightface/models/buffalo_l/w600k_r50.onnx \
    && test -f /opt/insightface/models/buffalo_l/det_10g.onnx
ENV INSIGHTFACE_HOME=/opt/insightface

COPY h3_handler.py /h3_handler.py
COPY swap_prepare.py /swap_prepare.py
COPY swap_faces.py /swap_faces.py
# Import check, and one real face pass on a blank frame (loads the three models, finds no face).
RUN cd / && python -c "import numpy as np, swap_prepare, swap_faces, av, PIL; assert swap_faces.detect_faces(np.zeros((1, 480, 480, 3), np.uint8)) == []; import torch; print('swap ok, torch', torch.__version__, 'numpy', np.__version__)"

# Build-time smoke test: the custom node must import and register on CPU.
RUN cd /comfyui && timeout 300 python main.py --quick-test-for-ci --cpu 2>&1 | tee /tmp/quick.log \
    && ! grep -q "IMPORT FAILED" /tmp/quick.log \
    && echo "h3-relay ${H3_RELAY_COMMIT}" >> /comfyui/.h3_version

CMD ["/h3_start.sh"]
